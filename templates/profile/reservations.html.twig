{% extends 'base.html.twig' %}
{% block title %}Mes réservations{% endblock %}
{% block body %}

<div class="container mt-4">

    {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message }}</div>
    {% endfor %}
    {% for message in app.flashes('danger') %}
        <div class="alert alert-danger">{{ message }}</div>
    {% endfor %}

    {# RÉSERVATIONS FUTURES #}
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-dark text-white">
            <h5 class="mb-0"><i class="bi bi-calendar-check me-2"></i>Réservations à venir</h5>
        </div>
        <div class="card-body">
            {% if futureReservations|length == 0 %}
                <p class="text-muted">Aucune réservation à venir.</p>
            {% else %}
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Véhicule</th>
                            <th>Date début</th>
                            <th>Date fin</th>
                            <th>Prix total</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for reservation in futureReservations %}
                            <tr>
                                <td>{{ reservation.vehicle.name }}</td>
                                <td>{{ reservation.startDate|date('d/m/Y') }}</td>
                                <td>{{ reservation.endDate|date('d/m/Y') }}</td>
                                <td>{{ reservation.totalPrice }} €</td>
                                <td>
                                    <a href="{{ path('app_profile_reservation_edit', { id: reservation.id }) }}"
                                       class="btn btn-sm btn-warning">
                                        <i class="bi bi-pencil"></i> Modifier
                                    </a>
                                    <form method="post"
                                          action="{{ path('app_profile_reservation_delete', { id: reservation.id }) }}"
                                          class="d-inline"
                                          onsubmit="return confirm('Confirmer la suppression ?')">
                                        <input type="hidden" name="_token"
                                               value="{{ csrf_token('delete_reservation_' ~ reservation.id) }}">
                                        <button type="submit" class="btn btn-sm btn-danger">
                                            <i class="bi bi-trash"></i> Supprimer
                                        </button>
                                    </form>
                                    <a href="{{ path('app_reservation_bon', { token: reservation.confirmationToken }) }}"
                                       class="btn btn-sm btn-dark">
                                        <i class="bi bi-file-earmark"></i> Bon
                                    </a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% endif %}
        </div>
    </div>

    {# RÉSERVATIONS PASSÉES #}
    <div class="card shadow-sm">
        <div class="card-header bg-secondary text-white">
            <h5 class="mb-0"><i class="bi bi-clock-history me-2"></i>Réservations passées</h5>
        </div>
        <div class="card-body">
            {% if pastReservations|length == 0 %}
                <p class="text-muted">Aucune réservation passée.</p>
            {% else %}
                <table class="table table-hover text-muted">
                    <thead>
                        <tr>
                            <th>Véhicule</th>
                            <th>Date début</th>
                            <th>Date fin</th>
                            <th>Prix total</th>
                            <th>Bon</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for reservation in pastReservations %}
                            <tr>
                                <td>{{ reservation.vehicle.name }}</td>
                                <td>{{ reservation.startDate|date('d/m/Y') }}</td>
                                <td>{{ reservation.endDate|date('d/m/Y') }}</td>
                                <td>{{ reservation.totalPrice }} €</td>
                                <td>
                                    <a href="{{ path('app_reservation_bon', { token: reservation.confirmationToken }) }}"
                                       class="btn btn-sm btn-outline-dark">
                                        <i class="bi bi-file-earmark"></i> Voir
                                    </a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% endif %}
        </div>
    </div>

    <div class="mt-3">
        <a href="{{ path('app_profile') }}" class="btn btn-outline-dark">
            <i class="bi bi-arrow-left me-1"></i> Retour au profil
        </a>
    </div>
</div>

{% endblock %}