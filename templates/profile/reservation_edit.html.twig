{% extends 'base.html.twig' %}
{% block title %}Modifier ma réservation{% endblock %}
{% block body %}

<div class="row justify-content-center mt-5">
    <div class="col-md-6">

        {% for message in app.flashes('danger') %}
            <div class="alert alert-danger">{{ message }}</div>
        {% endfor %}

        <div class="card shadow-sm">
            <div class="card-header bg-dark text-white">
                <h5 class="mb-0">
                    <i class="bi bi-pencil me-2"></i>Modifier la réservation — {{ reservation.vehicle.name }}
                </h5>
            </div>
            <div class="card-body p-4">
                {{ form_start(form, { attr: { novalidate: 'novalidate' } }) }}

                <div class="mb-3">
                    {{ form_label(form.startDate, 'Date de début', { label_attr: { class: 'form-label fw-semibold' } }) }}
                    {{ form_widget(form.startDate, { attr: { class: 'form-control' } }) }}
                    {{ form_errors(form.startDate) }}
                </div>

                <div class="mb-4">
                    {{ form_label(form.endDate, 'Date de fin', { label_attr: { class: 'form-label fw-semibold' } }) }}
                    {{ form_widget(form.endDate, { attr: { class: 'form-control' } }) }}
                    {{ form_errors(form.endDate) }}
                </div>

                <button type="submit" class="btn btn-dark w-100">
                    <i class="bi bi-check-circle me-1"></i> Enregistrer les modifications
                </button>

                {{ form_end(form) }}
            </div>
            <div class="card-footer text-center text-muted">
                <a href="{{ path('app_profile_reservations') }}">
                    <i class="bi bi-arrow-left me-1"></i> Retour à mes réservations
                </a>
            </div>
        </div>
    </div>
</div>

{% endblock %}