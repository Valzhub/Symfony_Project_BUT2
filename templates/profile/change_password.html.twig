{% extends 'base.html.twig' %}
{% block title %}Changer mon mot de passe{% endblock %}
{% block body %}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">

        {% for message in app.flashes('danger') %}
            <div class="alert alert-danger alert-dismissible fade show">
                <i class="bi bi-exclamation-triangle me-2"></i>{{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}

        <div class="card shadow-sm">
            <div class="card-header bg-dark text-white">
                <h5 class="mb-0"><i class="bi bi-shield-lock me-2"></i>Changer mon mot de passe</h5>
            </div>
            <div class="card-body p-4">

                {{ form_start(form, { attr: { novalidate: 'novalidate' } }) }}

                <div class="mb-3">
                    {{ form_label(form.currentPassword, 'Mot de passe actuel', { label_attr: { class: 'form-label fw-semibold' } }) }}
                    {{ form_widget(form.currentPassword, { attr: { class: 'form-control', placeholder: '••••••••' } }) }}
                    {{ form_errors(form.currentPassword) }}
                </div>

                <hr>

                <div class="mb-3">
                    {{ form_label(form.newPassword.first, 'Nouveau mot de passe', { label_attr: { class: 'form-label fw-semibold' } }) }}
                    {{ form_widget(form.newPassword.first, { attr: { class: 'form-control', placeholder: '••••••••' } }) }}
                    {{ form_errors(form.newPassword.first) }}
                </div>

                <div class="mb-4">
                    {{ form_label(form.newPassword.second, 'Confirmer le nouveau mot de passe', { label_attr: { class: 'form-label fw-semibold' } }) }}
                    {{ form_widget(form.newPassword.second, { attr: { class: 'form-control', placeholder: '••••••••' } }) }}
                    {{ form_errors(form.newPassword.second) }}
                    <div class="form-text">Minimum 6 caractères.</div>
                </div>

                <button type="submit" class="btn btn-dark w-100">
                    <i class="bi bi-envelope-check me-1"></i> Recevoir le code de confirmation
                </button>

                {{ form_end(form) }}

            </div>
            <div class="card-footer text-center text-muted">
                <a href="{{ path('app_profile') }}"><i class="bi bi-arrow-left me-1"></i>Retour au profil</a>
            </div>
        </div>

    </div>
</div>

{% endblock %}