{% extends 'base.html.twig' %}
{% block title %}Bon de réservation{% endblock %}
{% block body %}

<div class="row justify-content-center mt-4">
    <div class="col-md-7">
        <div class="card shadow-sm" id="bon">
            <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-file-earmark-check me-2"></i>Bon de réservation</h5>
                <span class="badge bg-success">Confirmé</span>
            </div>
            <div class="card-body p-4">
                <h6 class="text-muted mb-3">Magic Vehicles</h6>
                <hr>
                <div class="row mb-2">
                    <div class="col-5 fw-semibold">Véhicule</div>
                    <div class="col-7">{{ vehicle.name }}</div>
                </div>
                <div class="row mb-2">
                    <div class="col-5 fw-semibold">Client</div>
                    <div class="col-7">{{ reservation.user.firstName }} {{ reservation.user.lastName }}</div>
                </div>
                <div class="row mb-2">
                    <div class="col-5 fw-semibold">Email</div>
                    <div class="col-7">{{ reservation.user.email }}</div>
                </div>
                <div class="row mb-2">
                    <div class="col-5 fw-semibold">Date de début</div>
                    <div class="col-7">{{ reservation.startDate|date('d/m/Y') }}</div>
                </div>
                <div class="row mb-2">
                    <div class="col-5 fw-semibold">Date de fin</div>
                    <div class="col-7">{{ reservation.endDate|date('d/m/Y') }}</div>
                </div>
                <div class="row mb-2">
                    <div class="col-5 fw-semibold">Référence</div>
                    <div class="col-7"><code>{{ reservation.confirmationToken }}</code></div>
                </div>
                <hr>
                <p class="text-muted small">Présentez ce bon lors de la récupération du véhicule. Le paiement s'effectue au comptoir.</p>
            </div>
            <div class="card-footer text-center">
                <button onclick="window.print()" class="btn btn-dark">
                    <i class="bi bi-printer me-1"></i> Imprimer le bon
                </button>
            </div>

            <a href="{{ path('app_reservation_bon_pdf', { token: reservation.confirmationToken }) }}"
                class="btn btn-outline-dark ms-2">
                <i class="bi bi-file-pdf me-1"></i> Télécharger en PDF
            </a>
        </div>
    </div>
</div>

{% endblock %}