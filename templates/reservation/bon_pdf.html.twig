<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <style>
        body { font-family: Arial, sans-serif; padding: 30px; }
        h1 { color: #333; }
        .info { margin: 10px 0; }
        .label { font-weight: bold; }
        hr { margin: 20px 0; }
        .footer { margin-top: 40px; font-size: 12px; color: #666; }
    </style>
</head>
<body>
    <h1>Bon de réservation — Magic Vehicles</h1>
    <hr>
    <div class="info"><span class="label">Véhicule :</span> {{ vehicle.name }}</div>
    <div class="info"><span class="label">Client :</span> {{ reservation.user.firstName }} {{ reservation.user.lastName }}</div>
    <div class="info"><span class="label">Email :</span> {{ reservation.user.email }}</div>
    <div class="info"><span class="label">Date de début :</span> {{ reservation.startDate|date('d/m/Y') }}</div>
    <div class="info"><span class="label">Date de fin :</span> {{ reservation.endDate|date('d/m/Y') }}</div>
    <div class="info"><span class="label">Prix total :</span> {{ reservation.totalPrice }} €</div>
    <div class="info"><span class="label">Référence :</span> {{ reservation.confirmationToken }}</div>
    <hr>
    <div class="footer">
        Présentez ce document lors de la récupération du véhicule. Le paiement s'effectue au comptoir.
    </div>
</body>
</html>