{# templates/vehicle/_list.html.twig #}

<div class="row">
    {% for vehicle in pagination %}
        <div class="col-xl-3 col-xxl-3 col-lg-4 col-md-6 mb-4">
            <div class="card shadow-sm border-primary h-100 d-flex flex-column">
                
                <a href="{{ path('details_vehicle', {id: vehicle.id}) }}">
                    <img src="{{ asset(vehicle.imagePath) }}" 
                         class="card-img-top object-fit-cover" 
                         height="300">
                </a>

                <div class="card-body d-flex flex-column">

                    <h5 class="card-title text-primary">
                        <a href="{{ path('details_vehicle', {id: vehicle.id}) }}" 
                           class="text-decoration-none text-primary">
                            {{ vehicle.name }}
                        </a>
                    </h5>

                    <p class="card-text flex-grow-1">
                        <i class="bi bi-bookmark-star"></i> 
                        <strong>Type :</strong> {{ vehicle.typeVehicle.name }}<br>

                        <i class="bi bi-people-fill"></i> 
                        <strong>Capacité :</strong> {{ vehicle.capacity }} passagers<br>

                        <i class="bi bi-gem"></i> 
                        <strong>Tarif :</strong> {{ vehicle.price }} galions / jour<br>

                        <i class="bi bi-stars"></i> 
                        <strong>Enchantements :</strong>

                        {% for f in vehicle.features %}
                            {{ f.name }}{% if not loop.last %}, {% endif %}
                        {% endfor %}
                    </p>

                    <div class="d-grid gap-2 mt-auto">
                        <a class="btn btn-info" 
                           href="{{ path('details_vehicle', {id: vehicle.id}) }}">
                            <i class="bi bi-crystal-ball"></i> Détails
                        </a>

                        {% set startDate = app.request.query.all('form')['startDate'] ?? '' %}
                        {% set endDate   = app.request.query.all('form')['endDate']   ?? '' %}

                        <a href="{{ path('reservation_vehicle', {
                            id: vehicle.id,
                            startDate: startDate,
                            endDate: endDate
                        }) }}" class="btn btn-dark btn-sm">
                            <i class="bi bi-calendar-check me-1"></i> Réserver
                        </a>
                    </div>

                    <hr>

                    {% if is_granted('ROLE_ADMIN') %}
                        <div class="d-flex justify-content-between">
                            <a href="{{ path('vehicle_edit_or_create', { id: vehicle.id }) }}" 
                               class="btn btn-warning btn-sm">
                                <i class="bi bi-quill"></i> Modifier
                            </a>

                            <a href="{{ path('vehicle_confirm_delete', { id: vehicle.id }) }}" 
                               class="btn btn-danger btn-sm">
                                <i class="bi bi-skull"></i> Supprimer
                            </a>
                        </div>
                    {% endif %}

                </div>
            </div>
        </div>
    {% else %}
        <p class="text-center">Aucun véhicule disponible.</p>
    {% endfor %}
</div>

<div class="d-flex justify-content-center mt-4">
    {{ knp_pagination_render(pagination) }}
</div>