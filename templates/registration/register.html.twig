{% extends 'base.html.twig' %}
{% block title %}Créer un compte{% endblock %}
{% block body %}

<div class="row justify-content-center mt-5">
    <div class="col-md-6">

        {% for flash_error in app.flashes('verify_email_error') %}
            <div class="alert alert-danger">{{ flash_error }}</div>
        {% endfor %}

        <div class="card shadow-sm">
            <div class="card-header bg-dark text-white">
                <h5 class="mb-0"><i class="bi bi-person-plus me-2"></i>Créer un compte</h5>
            </div>
            <div class="card-body p-4">
                {{ form_start(registrationForm, { attr: { novalidate: 'novalidate' } }) }}

                <div class="mb-3">
                    {{ form_label(registrationForm.email, 'Adresse email', { label_attr: { class: 'form-label fw-semibold' } }) }}
                    {{ form_widget(registrationForm.email, { attr: { class: 'form-control', placeholder: 'exemple@domaine.com' } }) }}
                    {{ form_errors(registrationForm.email) }}
                </div>

                <div class="row mb-3">
                    <div class="col">
                        {{ form_label(registrationForm.firstName, 'Prénom', { label_attr: { class: 'form-label fw-semibold' } }) }}
                        {{ form_widget(registrationForm.firstName, { attr: { class: 'form-control' } }) }}
                        {{ form_errors(registrationForm.firstName) }}
                    </div>
                    <div class="col">
                        {{ form_label(registrationForm.lastName, 'Nom', { label_attr: { class: 'form-label fw-semibold' } }) }}
                        {{ form_widget(registrationForm.lastName, { attr: { class: 'form-control' } }) }}
                        {{ form_errors(registrationForm.lastName) }}
                    </div>
                </div>

                <div class="mb-3">
                    {{ form_label(registrationForm.address, 'Adresse', { label_attr: { class: 'form-label fw-semibold' } }) }}
                    {{ form_widget(registrationForm.address, { attr: { class: 'form-control', rows: 2 } }) }}
                    {{ form_errors(registrationForm.address) }}
                </div>

                <div class="mb-3">
                    {{ form_label(registrationForm.phone, 'Téléphone', { label_attr: { class: 'form-label fw-semibold' } }) }}
                    {{ form_widget(registrationForm.phone, { attr: { class: 'form-control', placeholder: '06 00 00 00 00' } }) }}
                    {{ form_errors(registrationForm.phone) }}
                </div>

                <div class="mb-4">
                    {{ form_label(registrationForm.plainPassword, 'Mot de passe', { label_attr: { class: 'form-label fw-semibold' } }) }}
                    {{ form_widget(registrationForm.plainPassword, { attr: { class: 'form-control', placeholder: 'Obligatoire' } }) }}
                    {{ form_errors(registrationForm.plainPassword) }}
                </div>

                <button type="submit" class="btn btn-dark w-100">
                    <i class="bi bi-check-circle me-1"></i> Créer mon compte
                </button>

                {{ form_end(registrationForm) }}
            </div>
            <div class="card-footer text-center text-muted">
                Déjà un compte ? <a href="{{ path('app_login') }}">Se connecter</a>
            </div>
        </div>
    </div>
</div>

{% endblock %}